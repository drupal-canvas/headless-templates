# Server only. Set this in the process environment before starting Angular.
CANVAS_SITE_URL=https://your-drupal-site.example

# Exact direct/upstream hostnames; default: localhost,127.0.0.1.
# CANVAS_ALLOWED_HOSTS=frontend.example
# HTTPS proxy opt-in: set BOTH only after verifying DEPLOYMENT.md prerequisites.
# The IP must identify the actual final proxy socket peer, not X-Forwarded-For.
# CANVAS_PROXY_ORIGIN=https://frontend.example
# CANVAS_TRUSTED_PROXY_IPS=127.0.0.1
